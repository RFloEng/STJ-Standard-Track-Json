#usda 1.0
(
    customLayerData = {
        string stj = '{"_metadata":{"specification":"STJ","version":"0.4","coordinate_system":"OpenDRIVE","units":"SI","description":"The dense patch of surface_maps.usda in a Y-up stage in centimetres, 1 m above the origin. A reader turns it into the STJ frame (spec 4.5) and gets the same surfaces.","author":"STJ examples","licence":{"spdx":"Apache-2.0","holder":"STJ contributors","redistributable":true},"provenance":{"type":"original","detail":"Generated by examples/features/make_features.py","confidence":"high"}},"track_info":{"name":"STJ surface maps, Y up","type":"point_to_point","fictional":true},"reference":{"centerline":{"points":[[0,4,0],[10,4,0]],"width":{"left":4.0,"right":4.0}}},"geometry":{"meshes":[{"id":"patches","uri":"surface_maps_yup.usda","roles":["collision"]}]},"surfaces":{"default":"grass","library":{"asphalt":{"class":"asphalt","mf_scaling":{"LMUX":1.0,"LMUY":1.0},"wet_response":[[0,1.0],[0.002,0.6]],"water":{"storage_depth":0.0004}},"gravel":{"class":"gravel","mf_scaling":{"LMUX":0.6,"LMUY":0.65}},"grass":{"class":"grass","mf_scaling":{"LMUX":0.5,"LMUY":0.5}},"concrete":{"class":"concrete","mf_scaling":{"LMUX":0.95,"LMUY":0.95}},"packed_snow":{"class":"snow","mf_scaling":{"LMUX":0.3,"LMUY":0.3}}},"maps":[{"mesh_ref":"patches","material":"Dense","palette":["asphalt","gravel","grass"],"weights":{"encoding":"vertex_dense","attributes":["stj_surf_dense"]}}]}}'
    }
    defaultPrim = "track"
    metersPerUnit = 0.01
    upAxis = "Y"
)

def Xform "track"
{
    def "materials"
    {
        def Material "Dense"
        {
            token outputs:surface.connect = </track/materials/Dense/preview.outputs:surface>

            def Shader "preview"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.5, 0.5, 0.5)
                float inputs:roughness = 0.8
                token outputs:surface
            }
        }
    }

    def Mesh "dense" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        float3[] extent = [(0, 100, -800), (1000, 100, -0)]
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        rel material:binding = </track/materials/Dense>
        point3f[] points = [(0, 100, -0), (1000, 100, -0), (1000, 100, -800), (0, 100, -800)]
        float4[] primvars:stj_surf_dense = [(1, 0, 0, 0), (0, 0.75, 0.25, 0), (0, 0.75, 0.25, 0), (1, 0, 0, 0)] (
            interpolation = "vertex"
        )
        uniform token subdivisionScheme = "none"
    }
}

