#usda 1.0
(
    customLayerData = {
        string stj = "{\"_metadata\":{\"specification\":\"STJ\",\"version\":\"0.4\",\"coordinate_system\":\"OpenDRIVE\",\"units\":\"SI\",\"description\":\"A track that carries its look beside its collision surface: road and painted kerb are both (stj:collision), the infield only draws. The kerb paint is a texture on the kerb's material.\",\"author\":\"STJ examples\",\"licence\":{\"spdx\":\"Apache-2.0\",\"holder\":\"STJ contributors\",\"redistributable\":true},\"provenance\":{\"type\":\"original\",\"detail\":\"Generated by examples/features/make_features.py\",\"confidence\":\"high\"}},\"track_info\":{\"name\":\"STJ visual layer\",\"type\":\"point_to_point\",\"fictional\":true},\"reference\":{\"centerline\":{\"points\":[[0,0,0],[40,0,0]],\"width\":{\"left\":4.0,\"right\":4.0}}},\"geometry\":{\"meshes\":[{\"id\":\"track\",\"uri\":\"visual_layer.usda\",\"roles\":[\"collision\",\"visual\"]}]},\"surfaces\":{\"default\":\"grass\",\"library\":{\"asphalt\":{\"class\":\"asphalt\",\"mf_scaling\":{\"LMUX\":1.0,\"LMUY\":1.0},\"wet_response\":[[0,1.0],[0.002,0.6]],\"water\":{\"storage_depth\":0.0004}},\"gravel\":{\"class\":\"gravel\",\"mf_scaling\":{\"LMUX\":0.6,\"LMUY\":0.65}},\"grass\":{\"class\":\"grass\",\"mf_scaling\":{\"LMUX\":0.5,\"LMUY\":0.5}},\"concrete\":{\"class\":\"concrete\",\"mf_scaling\":{\"LMUX\":0.95,\"LMUY\":0.95}},\"packed_snow\":{\"class\":\"snow\",\"mf_scaling\":{\"LMUX\":0.3,\"LMUY\":0.3}},\"kerb\":{\"class\":\"kerb\",\"mf_scaling\":{\"LMUX\":0.9,\"LMUY\":0.9}}},\"bindings\":[{\"mesh_ref\":\"track\",\"material\":\"Kerb_Paint\",\"surface\":\"kerb\"}]},\"environment\":{\"sky\":{\"model\":\"physical\",\"turbidity\":2.5,\"clouds\":{\"coverage\":0.2,\"kind\":\"cumulus\"}},\"default_time\":{\"date\":\"2026-05-10\",\"local_time\":\"11:00\"}}}"
    }
    defaultPrim = "track"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "track"
{
    def "materials"
    {
        def Material "STJ__surface__asphalt"
        {
            token outputs:surface.connect = </track/materials/STJ__surface__asphalt/preview.outputs:surface>

            def Shader "preview"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.06, 0.06, 0.065)
                float inputs:roughness = 0.7
                token outputs:surface
            }
        }

        def Material "Kerb_Paint"
        {
            token outputs:surface.connect = </track/materials/Kerb_Paint/preview.outputs:surface>

            def Shader "preview"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </track/materials/Kerb_Paint/image.outputs:rgb>
                float inputs:roughness = 0.5
                token outputs:surface
            }

            def Shader "uv"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "image"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @textures/kerb_stripes.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </track/materials/Kerb_Paint/uv.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                color3f outputs:rgb
            }
        }

        def Material "Infield_Grass"
        {
            token outputs:surface.connect = </track/materials/Infield_Grass/preview.outputs:surface>

            def Shader "preview"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.07, 0.16, 0.03)
                float inputs:roughness = 0.95
                token outputs:surface
            }
        }
    }

    def Mesh "road" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        float3[] extent = [(0, -4, 0), (40, 4, 0)]
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        rel material:binding = </track/materials/STJ__surface__asphalt>
        point3f[] points = [(0, -4, 0), (40, -4, 0), (40, 4, 0), (0, 4, 0)]
        texCoord2f[] primvars:st = [(0, -1), (10, -1), (10, 1), (0, 1)] (
            interpolation = "vertex"
        )
        custom bool stj:collision = 1
        uniform token subdivisionScheme = "none"
    }

    def Mesh "kerb" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        float3[] extent = [(0, 4, 0), (40, 4.8, 0.03)]
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        rel material:binding = </track/materials/Kerb_Paint>
        point3f[] points = [(0, 4, 0), (40, 4, 0), (40, 4.8, 0.03), (0, 4.8, 0.03)]
        texCoord2f[] primvars:st = [(0, 0), (13.333333, 0), (13.333333, 1), (0, 1)] (
            interpolation = "vertex"
        )
        custom bool stj:collision = 1
        uniform token subdivisionScheme = "none"
    }

    def Mesh "infield" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        float3[] extent = [(0, 4.8, 0.03), (40, 20, 0.03)]
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        rel material:binding = </track/materials/Infield_Grass>
        point3f[] points = [(0, 4.8, 0.03), (40, 4.8, 0.03), (40, 20, 0.03), (0, 20, 0.03)]
        texCoord2f[] primvars:st = [(0, 2.4), (20, 2.4), (20, 10), (0, 10)] (
            interpolation = "vertex"
        )
        uniform token subdivisionScheme = "none"
    }
}

