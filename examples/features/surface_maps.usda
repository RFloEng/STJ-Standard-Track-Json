#usda 1.0
(
    customLayerData = {
        string stj = '{"_metadata":{"specification":"STJ","version":"0.4","coordinate_system":"OpenDRIVE","units":"SI","description":"Six 10 m patches: one per weight encoding of a surface map, a dominant contact, a material named after its surface and a bound one. Wet and winter variants.","author":"STJ examples","licence":{"spdx":"Apache-2.0","holder":"STJ contributors","redistributable":true},"provenance":{"type":"original","detail":"Generated by examples/features/make_features.py","confidence":"high"}},"track_info":{"name":"STJ surface maps","type":"point_to_point","fictional":true},"reference":{"centerline":{"points":[[0,4,0],[60,4,0]],"width":{"left":4.0,"right":4.0}}},"geometry":{"meshes":[{"id":"patches","uri":"surface_maps.usda","roles":["collision"]}]},"surfaces":{"default":"grass","library":{"asphalt":{"class":"asphalt","mf_scaling":{"LMUX":1.0,"LMUY":1.0},"wet_response":[[0,1.0],[0.002,0.6]],"water":{"storage_depth":0.0004}},"gravel":{"class":"gravel","mf_scaling":{"LMUX":0.6,"LMUY":0.65}},"grass":{"class":"grass","mf_scaling":{"LMUX":0.5,"LMUY":0.5}},"concrete":{"class":"concrete","mf_scaling":{"LMUX":0.95,"LMUY":0.95}},"packed_snow":{"class":"snow","mf_scaling":{"LMUX":0.3,"LMUY":0.3}}},"bindings":[{"mesh_ref":"patches","material":"Slab_01","surface":"concrete"}],"maps":[{"mesh_ref":"patches","material":"Dense","palette":["asphalt","gravel","grass"],"weights":{"encoding":"vertex_dense","attributes":["stj_surf_dense"]}},{"mesh_ref":"patches","material":"Image","palette":["asphalt","gravel","grass"],"weights":{"encoding":"image","maps":[{"uri":"maps/weights.png","channels":"rgb"}],"extent":[10,0,20,8]}},{"mesh_ref":"patches","material":"IdMap","palette":["asphalt","gravel","grass"],"weights":{"encoding":"id_map","maps":[{"uri":"maps/ids.png","channels":"gray"}],"extent":[20,0,30,8]}},{"mesh_ref":"patches","material":"Dominant","palette":["asphalt","gravel","grass"],"weights":{"encoding":"vertex_dense","attributes":["stj_surf_dense"]},"contact":"dominant"}]},"environment":{"default_weather":{"condition":"clear","water_depth":0.0},"weather_options":[{"weather":{"condition":"clear"},"weight":0.7},{"variant":"wet","weight":0.3}]},"variants":[{"id":"wet","name":"Rain","kind":"weather","override":"surface_maps_wet.usda"},{"id":"winter","name":"Winter","kind":"season","override":"surface_maps_winter.usda"}]}'
    }
    defaultPrim = "track"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "track"
{
    def "materials"
    {
        def Material "Dense"
        {
            token outputs:surface.connect = </track/materials/Dense/preview.outputs:surface>

            def Shader "preview"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.5, 0.5, 0.5)
                float inputs:roughness = 0.8
                token outputs:surface
            }
        }

        def Material "Image"
        {
