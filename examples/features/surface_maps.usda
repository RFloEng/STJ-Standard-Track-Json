            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.5, 0.5, 0.5)
                float inputs:roughness = 0.8
                token outputs:surface
            }
        }
    }

    def Mesh "dense" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        float3[] extent = [(0, 0, 0), (10, 8, 0)]
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        rel material:binding = </track/materials/Dense>
        point3f[] points = [(0, 0, 0), (10, 0, 0), (10, 8, 0), (0, 8, 0)]
        float4[] primvars:stj_surf_dense = [(1, 0, 0, 0), (0, 0.75, 0.25, 0), (0, 0.75, 0.25, 0), (1, 0, 0, 0)] (
            interpolation = "vertex"
        )
        uniform token subdivisionScheme = "none"
    }

    def Mesh "image" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        float3[] extent = [(10, 0, 0), (20, 8, 0)]
        int[] faceVertexCounts = [4]
