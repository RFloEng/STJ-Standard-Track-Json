    }

    def "materials"
    {
        def Material "Ground"
        {
            token outputs:surface.connect = </track/materials/Ground/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.32, 0.32, 0.3)
                float inputs:roughness
                token outputs:surface
            }
        }
    }

    def Xform "flag"
    {
        float xformOp:rotateZ.timeSamples = {
            0: -20,
            12: 20,
            24: -20,
        }
        double3 xformOp:translate = (232, 0, 1.5)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ"]
    }

    def Xform "cone" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        float physics:mass = 4.5

        def Cone "shape" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            uniform token axis = "Z"
            double height = 0.7
            double radius = 0.18
        }
    }
    variantSet "stj_condition" = {
        "dry" {
            over "materials"
            {
                over "Ground"
                {
                    over "surface"
                    {
                        float inputs:roughness = 0.8
                    }
                }
            }

        }
        "wet" {
            over "materials"
            {
                over "Ground"
                {
                    over "surface"
                    {
                        float inputs:roughness = 0.15
                    }
                }
            }

        }
    }
}

